# Production environment template. Copy to `.env` on the server and fill in
# every `change-me` / empty value. Never commit the real file.
# Generate the key once on the server: php artisan key:generate

APP_NAME=Restano
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://restano.app
CENTRAL_DOMAIN=restano.app

APP_LOCALE=tr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=tr_TR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=restano
DB_USERNAME=restano
DB_PASSWORD=change-me

# Host-only cookie on the central domain: SESSION_DOMAIN must stay empty
# (null), never `.restano.app` (tenant subdomains must not receive it).
SESSION_DRIVER=redis
SESSION_CONNECTION=session
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Tenant images on the server disk (storage/app/public via public/storage).
MEDIA_DRIVER=local

QUEUE_CONNECTION=redis
REDIS_QUEUE_CONNECTION=queue

CACHE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=change-me
REDIS_PORT=6379
REDIS_CACHE_DB=1
REDIS_QUEUE_DB=2
REDIS_SESSION_DB=3

# SMTP, provider-agnostic (details and DNS checklist: launch plan Faz 3).
# MAIL_SCHEME is the Symfony DSN scheme: empty for port 587 + STARTTLS,
# `smtps` for implicit TLS on port 465 (`tls` is not a valid value).
MAIL_MAILER=smtp
MAIL_SCHEME=
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=change-me
MAIL_PASSWORD=change-me
MAIL_FROM_ADDRESS="no-reply@restano.app"
MAIL_FROM_NAME="Restano"

# Legal texts show the "under review" notice until the lawyer review is done
# (launch plan Faz 10).
MARKETING_LEGAL_REVIEW_PENDING=true

# Error tracking (config/sentry.php). Empty DSN = nothing is sent.
# No personal data, request bodies, cookies or tracing (README § Monitoring).
SENTRY_LARAVEL_DSN=
# SENTRY_RELEASE=

# ops:health-check every 15 minutes (config/ops.php). Empty OPS_ALERT_EMAIL
# falls back to the platform contact e-mail in /admin → site settings.
OPS_ALERT_EMAIL=
OPS_ALERT_COOLDOWN_MINUTES=60
OPS_FAILED_JOBS_THRESHOLD=1
OPS_DISK_USAGE_THRESHOLD=85
# Turn on once backups run (launch plan Faz 4).
OPS_BACKUP_CHECK=false

VITE_APP_NAME="${APP_NAME}"
