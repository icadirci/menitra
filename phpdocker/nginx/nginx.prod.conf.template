# Production nginx site (docker-compose.prod.yml). The official nginx image
# renders this template into /etc/nginx/conf.d/default.conf at start-up and
# substitutes only defined environment variables (${CENTRAL_DOMAIN}), so
# nginx's own $variables are left alone.
#
# TLS ends at the host's nginx, which proxies to this container on
# 127.0.0.1 (HTTP_PORT in .env) (README: Reverse proxy and HTTPS). The X-Forwarded-*
# headers reach PHP through fastcgi_params; Laravel trusts them only from
# TRUSTED_PROXIES (config/trustedproxy.php). HSTS is sent by the app.

server_tokens off;

gzip on;
gzip_vary on;
gzip_proxied any;
gzip_comp_level 5;
gzip_min_length 1024;
gzip_types text/plain text/css text/xml application/javascript application/json application/xml application/rss+xml image/svg+xml;

# Requests for hosts we don't serve get no response.
server {
    listen 80 default_server;
    server_name _;
    return 444;
}

server {
    listen 80;
    server_name ${CENTRAL_DOMAIN} *.${CENTRAL_DOMAIN};

    root /application/public;
    index index.php;
    charset utf-8;

    # Largest tenant image is 5 MB (App\Enums\MediaType::maxKilobytes()) plus
    # multipart overhead; keep in sync with phpdocker/php-fpm/production/php.ini.
    client_max_body_size 8M;

    access_log /var/log/nginx/access.log;
    error_log /var/log/nginx/error.log warn;

    # No dotfiles (.env, .git, ...) except ACME challenges.
    location ~ /\.(?!well-known/) {
        deny all;
    }

    # Vite output is content-hashed; fonts are versioned with the build.
    location ^~ /build/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        access_log off;
        try_files $uri =404;
    }

    location ^~ /fonts/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        access_log off;
        try_files $uri =404;
    }

    # Uploaded tenant media (public/storage -> storage/app/public). Prefix
    # match (^~) so the PHP location below can never run anything here.
    location ^~ /storage/ {
        add_header X-Content-Type-Options "nosniff";
        location ~ \.php$ {
            return 404;
        }
        try_files $uri =404;
    }

    # robots.txt is served by RobotsController (no static file).
    location / {
        try_files $uri /index.php$is_args$args;
    }

    location = /favicon.ico {
        access_log off;
        log_not_found off;
        try_files $uri =404;
    }

    # Only the front controller is executed.
    location = /index.php {
        # Resolve php-fpm per request through Docker's DNS: a restarted
        # container (deploy.sh restarts php-fpm) can get a new IP.
        resolver 127.0.0.11 valid=10s ipv6=off;
        set $php_upstream php-fpm:9000;
        fastcgi_pass $php_upstream;
        fastcgi_param SCRIPT_FILENAME $realpath_root$fastcgi_script_name;
        fastcgi_param DOCUMENT_ROOT $realpath_root;
        fastcgi_buffers 16 16k;
        fastcgi_buffer_size 32k;
        include fastcgi_params;
        fastcgi_hide_header X-Powered-By;
        # TLS is terminated in front of nginx (out of scope for now); the
        # proxy work decides how HTTPS reaches PHP.
    }

    location ~ \.php$ {
        return 404;
    }
}
