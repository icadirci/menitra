APP_NAME=Menitra
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:37000
CENTRAL_DOMAIN=localhost

APP_LOCALE=tr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=restano
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=redis
SESSION_CONNECTION=session
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Tenant images (`media` disk). local = storage/app/public via public/storage.
# s3 requires league/flysystem-aws-s3-v3 (not installed; needs approval).
MEDIA_DRIVER=local
# MEDIA_URL=
# MEDIA_S3_KEY=
# MEDIA_S3_SECRET=
# MEDIA_S3_REGION=
# MEDIA_S3_BUCKET=
# MEDIA_S3_ENDPOINT=
# MEDIA_S3_USE_PATH_STYLE_ENDPOINT=false
QUEUE_CONNECTION=redis
REDIS_QUEUE_CONNECTION=queue

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_CACHE_DB=1
REDIS_QUEUE_DB=2
REDIS_SESSION_DB=3

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
MAIL_BILLING_FROM_ADDRESS=
MAIL_BILLING_FROM_NAME=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Error tracking (config/sentry.php); leave empty locally.
SENTRY_LARAVEL_DSN=

# ops:health-check (config/ops.php).
OPS_ALERT_EMAIL=
OPS_BACKUP_CHECK=false

VITE_APP_NAME="${APP_NAME}"

# iyzico (payments). Sandbox keys: https://sandbox-merchant.iyzipay.com — production base URL: https://api.iyzipay.com
IYZICO_API_KEY=
IYZICO_SECRET_KEY=
IYZICO_BASE_URL=https://sandbox-api.iyzipay.com

# Google Ads tag (marketing, registration and email verification pages only; loaded after cookie consent).
# GOOGLE_ADS_ID=AW-…, GOOGLE_ADS_SIGNUP_CONVERSION=AW-…/label. Leave empty locally.
GOOGLE_ADS_ID=
GOOGLE_ADS_SIGNUP_CONVERSION=
